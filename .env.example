# 复制为 .env 并填写；本仓库绝不提交真实密钥。所有变量也可直接注入环境变量。

# ---- 模型 ----
# 默认模型：mock / gpt-4o-mini / claude-3-5-sonnet-latest / ollama/llama3 / qwen-... / glm-... / deepseek-...
DEFAULT_MODEL=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- 渠道：企业微信（官方 API）----
CHANNEL=mock
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_CALLBACK_PORT=8081

# ---- 渠道：飞书（官方 API）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_CALLBACK_PORT=8082

# ---- 技能：从 GitHub 拉取（建议把 ref pin 到 commit/tag，勿用浮动分支）----
GITHUB_SKILLS_REPO=
GITHUB_SKILLS_REF=main
GITHUB_SKILLS_CACHE=.skill_cache
SKILLS_ALLOWLIST=
LOCAL_SKILLS_DIR=skills/builtin

# ---- 运行时 ----
DB_PATH=data/task_registry.db
HEARTBEAT_INTERVAL=30
MOCK_INTERVAL=3

# ---- 轻量长期记忆（P2，默认库）----
MEMORY_DB_PATH=data/memory.db

# ---- 语义记忆向量来源（可选，默认走内置哈希 n-gram 索引，零依赖）----
# 设 EMBEDDING_PROVIDER=ollama 或 openai 即启用真向量；不设=内置哈希索引。
# 换 provider 会自动重建全部向量（维度/空间变了，旧向量必须重算）。
# 本地 Ollama 需先启动并 pull 好模型（如 nomic-embed-text）；数据不出本机。
EMBEDDING_PROVIDER=
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- 分布式：HTTP API（路线 1）----
# 设 API_AUTH_ENABLED=1 后开启 Bearer 鉴权；API_TOKENS 为逗号分隔的静态令牌。
API_PORT=8080
API_AUTH_ENABLED=0
API_TOKENS=
JWT_SECRET=
OAUTH_INTROSPECTION_URL=
# 客户端侧（runner 跨机接入 / MCP api_health）：指向已启动的 API 服务
API_BASE=
API_TOKEN=

# ---- 分布式：消息队列（路线 1）----
# 设 REDIS_URL 后自动从本地 SQLite 队列切到 Redis（跨机）。MQ_DB_PATH 为本地队列库路径。
# QUEUE_BACKEND 可锁定后端：auto（默认，Redis 可用则用 Redis）/ redis / local。
REDIS_URL=
QUEUE_BACKEND=auto
MQ_DB_PATH=data/mq.db
# 跨机协同三件套总开关（transport/distributed.py：分布式锁 + 心跳 + 死信队列）：
# SECTRUST_REDIS=1 且 REDIS_URL 可达 → ExecutionDaemon 启用跨机认领守卫/心跳/死信；
# 强开但不可达 = 构造即报错（拒绝静默降级回单机语义）；不设/0 = 完全不启用。
SECTRUST_REDIS=0

# ---- 扫描深度（路线 2）----
# 装了 semgrep（pip install semgrep）后，run_scan(engine="semgrep") 自动升级为 AST 级扫描；否则回退正则。
# 设 LIVE_VALIDATION=1 后，疑似密钥会做真实 API 活体验证（如 GitHub token）。
LIVE_VALIDATION=0

# ---- 可观测性（路线 5）----
# 装了 opentelemetry-sdk + opentelemetry-exporter-otlp 后，设 OTEL_ENABLED=1 启用 OTLP 追踪导出。
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- 渠道：飞书加密（可选，开启事件加密时填写 Encrypt Key）----
FEISHU_ENCRYPT_KEY=

# ---- 沙箱（默认 auto：探测 Docker -> E2B -> 本地受限降级）----
# 本地降级为弱隔离，仅用于可信低强度任务；生产务必用 Docker 或 E2B 强隔离。
# 配置 E2B_API_KEY 后，SandboxManager 可选用 E2B 远程沙箱（需 pip install e2b）。
E2B_API_KEY=
# 可选：锁定沙箱后端（auto / docker / local），不设则由 SandboxManager.auto() 自动探测
SANDBOX_BACKEND=auto

# ---- Docker 沙箱八条规格配置（SECTRUST_SANDBOX_*，不改代码即可套用）----
# 1 每任务独立容器、结束即销毁（--rm + kill + cleanup_stale）恒开，无需配置
# 2 非 root：SECTRUST_SANDBOX_USER 覆盖默认 nobody（POSIX 非 root 调用者用自身 uid:gid）
SECTRUST_SANDBOX_USER=
# 3 根文件系统只读：SECTRUST_SANDBOX_ROOTFS=0 可关（默认 1，弱化需显式）
SECTRUST_SANDBOX_ROOTFS=1
# 4 默认断网：SECTRUST_SANDBOX_NETWORK=none（断网，外发须持已批准 approval_id）
#   / bridge（仍须审批才放行——env 只改默认值，不绕审批门）
SECTRUST_SANDBOX_NETWORK=none
# 5 资源上限：内存 MB / CPU 核数 / 进程数
SECTRUST_SANDBOX_MEMORY_MB=512
SECTRUST_SANDBOX_CPUS=1
SECTRUST_SANDBOX_PIDS=128
# 6 输入只读/输出单独挂载由调用方传 input_dir/output_dir，无 env
# 7 命令白名单：逗号分隔的 argv[0]（空=不启用，保持旧自由执行语义）
SECTRUST_SANDBOX_ALLOWED=
# 8 运行时：runsc（gVisor）/ kata 等，默认 runc
SECTRUST_SANDBOX_RUNTIME=
# 镜像与拉取策略（镜像需自带白名单内的解释器，如 python:3.12-alpine）
SECTRUST_SANDBOX_IMAGE=alpine:3.20
SECTRUST_SANDBOX_PULL=0
